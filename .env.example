# Copie para .env (fora do git) e preencha. Nunca commite o .env.
# Variáveis do SERVIDOR (rest-api). Nada daqui vai para o app mobile.

# Speech-to-text
OPENAI_API_KEY=
# Extração estruturada (LLM)
ANTHROPIC_API_KEY=
# Assinatura dos tokens de sessão
JWT_SECRET=
# Caminho do arquivo SQLite
DB_PATH=./data/kcal.sqlite
# Porta da API (padrão 3000)
PORT=3000
