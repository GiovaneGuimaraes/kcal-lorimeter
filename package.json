    "dev:api": "pnpm --filter @kcal/rest-api dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3"
  }
}
